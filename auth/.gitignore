# ==========================================
# FRONTEND .gitignore BOILERPLATE
# ==========================================

# Node modules
node_modules/

# Build output
dist/
build/
.next/
out/

# Local environment files
.env
.env.test
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# System files
.DS_Store
Thumbs.db

# Optional cache files
.cache/
.tmp/
coverage/
*.log

# Dependency directories
bower_components/

# Lock files (optional – uncomment if you use a single package manager)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
jest.config.js

# Tailwind / PostCSS cache
.postcss-cache/
tailwind.config.js.bak

# TypeScript build artifacts
*.tsbuildinfo

# Storybook build
storybook-static/

# VSCode settings backups
.vscode/*

# Misc
*.local
*.swp
*.swo
